# ----- General -----
PAYMENTS_ENABLED="true"
CORS_ALLOWED_ORIGINS="https://app.visionprice.mx"

# ----- Base de datos (Docker) -----
DATABASE_URL="postgresql+asyncpg://payments:payments@db:5432/payments"

# ----- JWT (auth de usuarios de VisionPrice) -----
JWT_SECRET="pon-aqui-el-mismo-secreto-que-usa-visionprice"
JWT_ALGORITHM="HS256"
# JWT_AUDIENCE=""   # opcional

# ----- Conekta -----
# Test: key_...  |  Producción: key_live_...
CONEKTA_PRIVATE_KEY="key_xxxxxxxxxxxxxxxx"
CONEKTA_PLAN_PRO="planes-app-pro"
CONEKTA_PLAN_EQUIPOS="planes-app-equipo"

# ----- PayPal -----
PAYPAL_CLIENT_ID="xxxxxxxx"
PAYPAL_CLIENT_SECRET="xxxxxxxx"
PAYPAL_ENV="sandbox"            # "sandbox" | "live"
PAYPAL_PLAN_PRO=""             # se llena con scripts/bootstrap_paypal.py
PAYPAL_PLAN_EQUIPOS=""         # se llena con scripts/bootstrap_paypal.py
PAYPAL_WEBHOOK_ID=""           # se obtiene al registrar el webhook en el dashboard
PAYPAL_BRAND_NAME="Vision Price"
PAYPAL_RETURN_URL="https://app.visionprice.mx/pagos/paypal/return"
PAYPAL_CANCEL_URL="https://app.visionprice.mx/pagos/paypal/cancel"
